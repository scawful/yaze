# Forest Theme
# Deep forest theme with calm editor chrome and clear interaction states
name=Forest
description=Calm dark workspace with forest-green accents
author=YAZE Team
version=3.0

[colors]
# Brand accents stay green; structural surfaces stay neutral and quiet.
primary=100,180,120,255
secondary=70,130,85,255
accent=130,220,150,255
background=13,18,15,255
surface=21,27,23,255

# Status colors
error=255,120,120,255
warning=255,220,120,255
success=100,180,120,255
info=120,200,180,255

# Text colors (enhanced for readability)
text_primary=238,244,239,255
text_secondary=180,196,185,255
text_disabled=112,128,117,255

# Window colors (better contrast)
window_bg=15,20,17,248
child_bg=19,25,21,245
popup_bg=24,31,26,255

# Neutral controls reserve green for hover, selection, and confirmation.
button=37,49,41,255
button_hovered=50,68,56,255
button_active=67,94,75,255
frame_bg=28,37,31,240
frame_bg_hovered=38,52,43,250
frame_bg_active=48,69,56,255

# Navigation (better contrast)
header=31,42,35,255
header_hovered=43,59,49,255
header_active=52,74,60,255
tab=23,31,26,255
tab_hovered=38,52,43,255
tab_active=52,74,60,255
menu_bar_bg=19,26,22,255
title_bg=23,31,26,255
title_bg_active=31,42,35,255
title_bg_collapsed=19,26,22,255

# Borders and separators
border=74,91,79,115
border_shadow=0,0,0,0
separator=88,105,94,105
separator_hovered=100,180,120,180
separator_active=130,220,150,225

# Scrollbars
scrollbar_bg=13,18,15,160
scrollbar_grab=52,68,57,190
scrollbar_grab_hovered=70,96,79,225
scrollbar_grab_active=100,180,120,245

# Resize grips
resize_grip=255,255,255,26
resize_grip_hovered=130,220,150,153
resize_grip_active=130,220,150,230

# Controls
check_mark=180,255,200,255       # Bright green checkmark
slider_grab=100,180,120,255
slider_grab_active=130,220,150,255

# Tables
table_header_bg=31,42,35,255
table_border_strong=74,91,79,150
table_border_light=52,64,56,105
table_row_bg=0,0,0,0
table_row_bg_alt=255,255,255,20

# Links
text_link=120,200,180,255        # Teal links

# Navigation and special elements
input_text_cursor=250,255,250,255
nav_cursor=130,220,150,255
nav_windowing_highlight=130,220,150,200
nav_windowing_dim_bg=0,0,0,128
modal_window_dim_bg=0,0,0,100
text_selected_bg=100,180,120,100
drag_drop_target=130,220,150,200

# Docking
docking_preview=100,180,120,180
docking_empty_bg=40,70,45,255

# Tree lines
tree_lines=88,105,94,95

# Tab variations
tab_dimmed=18,24,20,255
tab_dimmed_selected=31,42,35,255
tab_dimmed_selected_overline=130,220,150,255
tab_selected_overline=130,220,150,255

[style]
window_rounding=4.0
frame_rounding=4.0
scrollbar_rounding=6.0
grab_rounding=3.0
tab_rounding=4.0
window_border_size=0.0
frame_border_size=0.0
enable_animations=true
enable_glow_effects=false
animation_speed=1.0
